<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Kuid2Hash</RootNamespace>
    <AssemblyName>Kuid2Hash</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Chromatix-Keyboard-Keys-Hash.ico</ApplicationIcon>
    <StartupObject>Sub Main</StartupObject>

    <!-- Assembly metadata (moved from My Project\AssemblyInfo.vb) -->
    <Version>2.0.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <Company>SilverGreen93</Company>
    <Product>Kuid2Hash</Product>
    <Title>Kuid2Hash</Title>
    <Description>Utility for converting numeric kuids to hexadecimal values.</Description>
    <Copyright>Copyright © SilverGreen93 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="My Project\**" />
  </ItemGroup>

</Project>
